# Convención cam↔Webots: x_w=x_mm/1000−1.900 · y_w=1.400−y_mm/1000.

EXTERNPROTO "../protos/AttaBot.proto"

WorldInfo {
  basicTimeStep 8
  contactProperties [
    ContactProperties {
      material1 "attabot_body"
      coulombFriction [ 0.05 ]
    }
    ContactProperties {
      material1 "attabot_wheel"
      coulombFriction [ 3 ]
    }
  ]
}
