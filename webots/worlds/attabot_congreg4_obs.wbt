}

Solid {
  translation -1.210 0.000 0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.4 0.4 0.45 roughness 1 metalness 0 } geometry Box { size 0.020 1.750 0.1 } } ]
  name "wall west"
  boundingObject Box { size 0.020 1.750 0.1 }
}

Solid {
  name "obstacle box"
  translation 0.500 0.000 0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.55 0.35 0.2 roughness 1 metalness 0 } geometry Box { size 0.150 0.150 0.1 } } ]
  boundingObject Box { size 0.150 0.150 0.1 }
}

Solid {
  name "obstacle box 2"
  translation -0.310 0.391 0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.55 0.35 0.2 roughness 1 metalness 0 } geometry Box { size 0.150 0.150 0.1 } } ]
  boundingObject Box { size 0.150 0.150 0.1 }
}

AttaBot {
  translation 0.0000 0.0000 0
  rotation 0 0 1 0
  name "Atta_1"
  customData "1"
  bodyColor 0.85 0.85 0.85
}

AttaBot {
