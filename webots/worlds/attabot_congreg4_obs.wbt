  children [ Shape { appearance PBRAppearance { baseColor 0.4 0.4 0.45 roughness 1 metalness 0 } geometry Box { size 2.440 0.020 0.1 } } ]
  name "wall south"
  boundingObject Box { size 2.440 0.020 0.1 }
}

Solid {
  translation 1.210 0.000 0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.4 0.4 0.45 roughness 1 metalness 0 } geometry Box { size 0.020 1.750 0.1 } } ]
