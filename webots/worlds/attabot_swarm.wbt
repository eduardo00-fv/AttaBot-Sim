#VRML_SIM R2025a utf8
# Arena AttaBot para ENJAMBRE — misma arena que attabot.wbt pero SIN el campo
# de obstáculos (cajas + cilindro). La dispersión y las formaciones son geometría
# inter-robot: los obstáculos solo estorban al líder camino al ancla (bloqueaban
# el GOTO a (1580,875), en el bolsillo de la caja 1). La evasión y la búsqueda
# semántica se validan aparte en attabot.wbt.
#   Marco de coordenadas "cámara": origen esquina superior-izquierda, x→ancho,
#   y→abajo, ángulo CW. Conversión desde Webots la hace base_camera.py.

EXTERNPROTO "../protos/AttaBot.proto"

WorldInfo {
  basicTimeStep 8
  contactProperties [
    ContactProperties {
      material1 "attabot_body"
      coulombFriction [ 0.05 ]
    }
    ContactProperties {
      material1 "attabot_wheel"
      coulombFriction [ 3 ]
    }
  ]
}
Viewpoint {
  orientation 0 1 0 1.2
  position -2.6 0 2.2
}
Background {
  skyColor [ 0.6 0.7 0.8 ]
}
DirectionalLight {
  direction 0.3 -0.2 -1
  intensity 2.5
  castShadows TRUE
}
# ── Piso ──────────────────────────────────────────────────────────────────
Solid {
  name "floor"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.85 0.82 roughness 1 metalness 0 }
      geometry Box { size 2.4 1.55 0.02 }
    }
  ]
  translation 0 0 -0.01
  boundingObject Box { size 2.4 1.55 0.02 }
}
# ── Paredes ───────────────────────────────────────────────────────────────
Solid {
  name "wall north"
  translation 0 0.785 0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.4 0.4 0.45 roughness 1 metalness 0 } geometry Box { size 2.44 0.02 0.1 } } ]
  boundingObject Box { size 2.44 0.02 0.1 }
}
Solid {
  name "wall south"
  translation 0 -0.785 0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.4 0.4 0.45 roughness 1 metalness 0 } geometry Box { size 2.44 0.02 0.1 } } ]
  boundingObject Box { size 2.44 0.02 0.1 }
}
Solid {
  name "wall east"
  translation 1.21 0 0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.4 0.4 0.45 roughness 1 metalness 0 } geometry Box { size 0.02 1.55 0.1 } } ]
  boundingObject Box { size 0.02 1.55 0.1 }
}
Solid {
  name "wall west"
  translation -1.21 0 0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.4 0.4 0.45 roughness 1 metalness 0 } geometry Box { size 0.02 1.55 0.1 } } ]
  boundingObject Box { size 0.02 1.55 0.1 }
}
# ── Robots (coords cámara: 1=(300,300), 2=(300,1200), 3=(300,750), 4=(600,750))
AttaBot {
  translation -0.9 0.475 0
  name "Atta_1"
  customData "1"
  bodyColor 0.75 0.2 0.2
}
AttaBot {
  translation -0.9 -0.425 0
  name "Atta_2"
  customData "2"
  bodyColor 0.2 0.35 0.75
}
AttaBot {
  translation -0.9 0.025 0
  name "Atta_3"
  customData "3"
  bodyColor 0.7 0.25 0.7
}
AttaBot {
  translation -0.6 0.025 0
  name "Atta_4"
  customData "4"
  bodyColor 0.75 0.65 0.15
}
# ── Base virtual (cámara ArUco simulada + router UDP) ─────────────────────
Robot {
  name "base_camera"
  controller "base_camera"
  supervisor TRUE
}
